# Куда пересылать запросы. mock — встроенная учебная модель.
# Примеры: http://localhost:11434/v1 (Ollama), https://api.openai.com/v1,
# https://openrouter.ai/api/v1
SHIRMA_UPSTREAM_URL=mock

# Если задан — подставляется вместо ключа клиента.
SHIRMA_UPSTREAM_API_KEY=

SHIRMA_POLICY=policy.example.yaml

# Демо-страница показывает таблицу «метка → значение». В бою — false.
SHIRMA_DEMO=true
